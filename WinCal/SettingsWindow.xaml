<Window x:Class="WinCal.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinCal" Width="520" SizeToContent="Height"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        WindowStartupLocation="CenterScreen" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Background="#F8F8F8">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="IcsLabel" Grid.Row="0" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox x:Name="IcsBox" Grid.Row="1" FontSize="12" Padding="6" MinHeight="66"
                 AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"/>
        <TextBlock x:Name="IcsHint" Grid.Row="2"
                   Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,12"/>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="FontLabel" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="FontCombo" FontSize="12" Padding="4" Margin="0,0,8,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="ThemeLabel" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="ThemeCombo" FontSize="12" Padding="4" Margin="0,0,8,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock x:Name="LangLabel" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="LangCombo" FontSize="12" Padding="4" Margin="0,0,8,0">
                    <ComboBoxItem Content="한국어"/>
                    <ComboBoxItem Content="English"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="3">
                <TextBlock x:Name="MonitorLabel" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="MonitorCombo" FontSize="12" Padding="4"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="RefreshLabel" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="RefreshBox" Width="60" HorizontalAlignment="Left" FontSize="12" Padding="4"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="WeekStartLabel" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="WeekStartCombo" FontSize="12" Padding="4">
                    <ComboBoxItem x:Name="WeekSun"/>
                    <ComboBoxItem x:Name="WeekMon"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="5" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <CheckBox x:Name="FullScreenCheck" FontWeight="SemiBold"
                      Checked="RegionToggle" Unchecked="RegionToggle"/>
            <CheckBox x:Name="SideMemoCheck" Grid.Row="0"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,4,0"/>
            <StackPanel x:Name="RegionPanel" Grid.Row="1" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="SizeLabel" VerticalAlignment="Center" Foreground="#666"/>
                    <TextBox x:Name="RegionW" Width="60" FontSize="12" Padding="4" Margin="6,0,2,0"/>
                    <TextBlock Text="×" VerticalAlignment="Center"/>
                    <TextBox x:Name="RegionH" Width="60" FontSize="12" Padding="4" Margin="2,0,4,0"/>
                    <TextBlock Text="px" VerticalAlignment="Center" Foreground="#666"/>
                </StackPanel>
                <TextBlock x:Name="RegionHint"
                           Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="6" Margin="0,0,0,10">
            <TextBlock FontWeight="SemiBold"><Run x:Name="ScaleRun"/><Run x:Name="ScaleLabel" Foreground="#888" FontWeight="Normal"/></TextBlock>
            <Slider x:Name="ScaleSlider" Minimum="0.5" Maximum="1.5" TickFrequency="0.05" Margin="0,2,0,0"
                    ValueChanged="ScaleSlider_ValueChanged"/>
        </StackPanel>

        <Grid Grid.Row="7" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontWeight="SemiBold"><Run x:Name="CellOpRun"/><Run x:Name="CellOpacityLabel" Foreground="#888" FontWeight="Normal"/></TextBlock>
                <Slider x:Name="OpacitySlider" Minimum="0.15" Maximum="1.0" Margin="0,4,8,0"
                        ValueChanged="OpacitySlider_ValueChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock FontWeight="SemiBold"><Run x:Name="WinOpRun"/><Run x:Name="WindowOpacityLabel" Foreground="#888" FontWeight="Normal"/></TextBlock>
                <Slider x:Name="WindowOpacitySlider" Minimum="0.3" Maximum="1.0" Margin="0,4,0,0"
                        ValueChanged="WindowOpacitySlider_ValueChanged"/>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="8">
            <CheckBox x:Name="StartupCheck" VerticalAlignment="Center"/>
            <Button x:Name="DefaultsButton" FontSize="11" Padding="10,2" Margin="14,0,0,0"
                    VerticalAlignment="Center" DockPanel.Dock="Left"
                    Click="Defaults_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Width="72" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"/>
                <Button x:Name="CancelButton" Width="72" IsCancel="True" Click="Cancel_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
