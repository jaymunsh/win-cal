<Window x:Class="WinCal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="False"
        ResizeMode="NoResize" Title="WinCal"
        Left="0" Top="0" Width="1024" Height="768">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Header bar: month title + action buttons -->
        <Border Grid.Row="0" Margin="4,4,4,2" Padding="10,4" CornerRadius="8"
                Background="#59000000" x:Name="HeaderBar">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="MonthTitle" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                               Foreground="#FFB0B0" FontSize="11" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel x:Name="HeaderButtons" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Weekday header -->
        <Grid Grid.Row="1" x:Name="WeekdayGrid" Margin="4,0,4,1"/>

        <!-- Day cells -->
        <Grid Grid.Row="2" x:Name="CellsGrid" Margin="4,1,4,4"/>

        <!-- Position-edit overlay (shown while "위치 조정" mode is active).
             Sits below stickers/side-memo so they stay interactive. -->
        <Grid x:Name="EditOverlay" Grid.Row="0" Grid.RowSpan="3" Grid.ColumnSpan="2" Visibility="Collapsed"
              Background="#26000000" MouseLeftButtonDown="EditOverlay_MouseDown">
            <Rectangle Stroke="#4CC2FF" StrokeThickness="2" StrokeDashArray="6 3" Margin="3"/>
            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"
                    Background="#99000000" CornerRadius="6" Padding="12,6">
                <TextBlock x:Name="EditHint" Foreground="White" FontSize="13"/>
            </Border>
            <Button x:Name="DoneButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="10" Padding="12,6" FontSize="13" Click="Done_Click"/>
            <Thumb x:Name="ResizeGrip" Width="22" Height="22" Margin="4"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Background="#4CC2FF" DragDelta="ResizeGrip_DragDelta"/>
        </Grid>

        <!-- Sticker layer (free-floating notes over the calendar) -->
        <Canvas x:Name="StickerLayer" Grid.Row="1" Grid.RowSpan="2"
                Margin="4,0,4,4" IsHitTestVisible="False"/>

        <!-- Side memo panel (right column, full height) -->
        <Border x:Name="SideMemoPanel" Grid.Column="1" Grid.Row="0" Grid.RowSpan="3"
                Margin="0,4,4,4" CornerRadius="8" Padding="10,8"/>
    </Grid>
</Window>
